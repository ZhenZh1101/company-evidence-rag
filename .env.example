# Export these variables in the shell; .env files are not automatically executed.
RAG_BASE_URL=http://127.0.0.1:18789/v1
RAG_CHAT_MODEL=openclaw/llm-gpt55
RAG_EMBEDDING_MODEL=openclaw/llm-gpt55
# Actual embedding model sent in x-openclaw-model for openclaw/ request models.
RAG_EMBEDDING_OPENCLAW_MODEL=openai/text-embedding-3-large
# Set to an empty string only to use the gateway's default embedding model.
# Optional: otherwise read gateway.auth.token only for a local RAG_BASE_URL.
# RAG_API_KEY=your-token
RAG_DB_PATH=data/rag.sqlite3
# Free self-hosted vector database; start it with docker compose up -d.
RAG_QDRANT_URL=http://127.0.0.1:6333

# Optional: use OpenAI for both embeddings and online Chat.
# Replace the defaults above and clear any previous Chat overrides:
# unset RAG_CHAT_BASE_URL RAG_CHAT_API_KEY RAG_CHAT_THINKING RAG_CHAT_REASONING_EFFORT
# RAG_BASE_URL=https://api.openai.com/v1
# RAG_API_KEY=your-openai-api-key
# RAG_EMBEDDING_MODEL=text-embedding-3-large
# RAG_CHAT_MODEL=gpt-4.1-mini
# RAG_CHAT_TOKEN_LIMIT_FIELD=max_completion_tokens
# RAG_CHAT_TEMPERATURE=0
# RAG_DB_PATH=data/rag-openai.sqlite3
# A different embedding endpoint/model needs a new database: ingest, then embed.

# Optional: use Z.AI for online query rewriting, evidence selection and answers.
# Keep RAG_BASE_URL / RAG_API_KEY / RAG_EMBEDDING_MODEL for embeddings.
# This also supports OpenAI embeddings + Z.AI Chat.
# unset RAG_CHAT_REASONING_EFFORT
# RAG_CHAT_BASE_URL=https://api.z.ai/api/paas/v4
# RAG_CHAT_API_KEY=your-zai-api-key
# RAG_CHAT_MODEL=glm-4.7
# RAG_CHAT_TOKEN_LIMIT_FIELD=max_tokens
# RAG_CHAT_TEMPERATURE=0.1
# RAG_CHAT_THINKING=disabled
# Without a chat endpoint override, chat uses RAG_BASE_URL and RAG_API_KEY.
# A different chat endpoint requires RAG_CHAT_API_KEY; no shared key is forwarded.
# Temperature defaults to 0; thinking is omitted unless enabled/disabled is set.
# For models that reject temperature, set RAG_CHAT_TEMPERATURE=none to omit it.
# RAG_CHAT_TOKEN_LIMIT_FIELD defaults to max_tokens; OpenAI uses max_completion_tokens.
# RAG_CHAT_REASONING_EFFORT is omitted by default; set only if supported by the model.
# RAG_CHAT_REASONING_EFFORT=none
# Optional JSON output mode for providers that support it; omitted by default.
# Use json_object or text; an empty value omits the field. Citation validation still applies.
# RAG_CHAT_RESPONSE_FORMAT=json_object
# RAG_TIMEOUT=180

# Hugging Face Docker Space defaults are set in Dockerfile.
# Add ONLY the two keys as Space Secrets (never commit keys):
# RAG_API_KEY=your-openai-api-key
# RAG_CHAT_API_KEY=your-zai-api-key
# RAG_BASE_URL=https://api.openai.com/v1
# RAG_EMBEDDING_MODEL=text-embedding-3-large
# RAG_CHAT_BASE_URL=https://api.z.ai/api/paas/v4
# RAG_CHAT_MODEL=glm-5.3-flash
# RAG_CHAT_THINKING=enabled
# RAG_CHAT_REASONING_EFFORT=low
# RAG_CHAT_TEMPERATURE=1
# RAG_CHAT_MIN_TOKENS=8192
# RAG_CHAT_RESPONSE_FORMAT=json_object
# GLM-5.3-Flash requires thinking; the floor includes reasoning + visible output.
# RAG_PUBLIC_ORIGIN=https://your-space-host.hf.space
# On HF this is inferred from SPACE_HOST. Only trust actual forwarding proxies.
# RAG_TRUSTED_PROXY_IPS=127.0.0.1/32,10.0.0.0/8
# RAG_RATE_LIMIT_DB_PATH=/app/runtime/rate-limits.sqlite3
# Counters survive app process restarts but ephemeral Space disk is not durable.

# Friend access: Docker requires accounts; local serving is optional.
# RAG_AUTH_REQUIRED=1
# Store this JSON as a Space Secret, never a public Variable:
# RAG_AUTH_USERS_JSON={"username":"pbkdf2_sha256$600000$<salt>$<hash>"}
# Generate/update hashes with: .venv/bin/python scripts/manage_users.py USERNAME
# The private local hash file is data/access-users.json (Git-ignored).
